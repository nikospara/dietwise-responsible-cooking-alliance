{
  "name": "responsible-cooking-alliance",
  "version": "1.1.2",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist-chrome; rm -rf dist-firefox",
    "dev": "vite",
    "build-chrome": "tsc && VITE_TARGET_BROWSER=Chrome vite build",
    "build-chrome-watch": "tsc && VITE_TARGET_BROWSER=Chrome VITE_WATCH=y vite build",
    "build-firefox": "tsc && VITE_TARGET_BROWSER=Firefox vite build",
    "build-firefox-watch": "tsc && VITE_TARGET_BROWSER=Firefox VITE_WATCH=y vite build",
    "build-all": "tsc && VITE_TARGET_BROWSER=Chrome vite build && VITE_TARGET_BROWSER=Firefox vite build",
    "lint": "eslint",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "classnames": "2.5.1",
    "jotai": "2.20.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "react-icons": "5.7.0",
    "react-markdown": "10.1.0",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "9.39.1",
    "@nabla/vite-plugin-eslint": "^3.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "0.2.5",
    "@types/eslint": "9.6.1",
    "@types/firefox-webext-browser": "143.0.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/turndown": "5.0.6",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitejs/plugin-react": "6.0.5",
    "autoprefixer": "10.5.4",
    "daisyui": "5.7.16",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.9.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "vite": "8.2.1",
    "vite-plugin-static-copy": "4.1.1",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "4.1.10"
  }
}
